{
  "name": "itruim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply quiz-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply quiz-db --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && vitest run && npm run audit:bundle",
    "audit:bundle": "tsx scripts/audit-bundle.ts",
    "admin:hash": "tsx scripts/hash-admin-password.ts",
    "admin:set-password": "tsx scripts/set-admin-password.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/vitest-plugin": "^1.1.9",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "4.1.11",
    "wrangler": "^4.131.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
